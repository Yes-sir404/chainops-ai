POSTGRES_DB=chainops
POSTGRES_USER=chainops
POSTGRES_PASSWORD=chainops_dev
POSTGRES_PORT=5432

# Restricts MCP filesystem execution to this directory.
# For local development, point this to packages/contracts.
CHAINOPS_WORKSPACE_ROOT=../contracts

# Maximum duration for a forge compilation process.
CHAINOPS_COMPILE_TIMEOUT_MS=60000

# Maximum duration for a forge test process.
CHAINOPS_TEST_TIMEOUT_MS=120000
